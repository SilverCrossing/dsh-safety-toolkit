{
  "name": "dsh-safety-toolkit",
  "version": "0.1.2",
  "private": true,
  "license": "AGPL-3.0-only",
  "type": "module",
  "description": "Safety-first file editing, rollback and verification tools for DeepSeek Harness",
  "repository": {
    "type": "git",
    "url": "git+https://github.com/SilverCrossing/dsh-safety-toolkit.git"
  },
  "main": "lib/index.js",
  "types": "lib/index.d.ts",
  "exports": {
    ".": {
      "types": "./lib/index.d.ts",
      "default": "./lib/index.js"
    },
    "./governance": {
      "types": "./lib/governance.d.ts",
      "default": "./lib/governance.js"
    },
    "./contract": {
      "types": "./lib/contract.d.ts",
      "default": "./lib/contract.js"
    },
    "./package.json": "./package.json"
  },
  "files": [
    "lib",
    "cordis.patch.yml",
    "LICENSE",
    "README.md",
    "README_EN.md"
  ],
  "dsh": {
    "bundle": {
      "patch": "./cordis.patch.yml"
    }
  },
  "engines": {
    "dsh": ">=0.2.0"
  },
  "scripts": {
    "build": "tsc -p tsconfig.build.json --noCheck",
    "typecheck": "tsc -p tsconfig.json --noEmit"
  },
  "peerDependencies": {
    "@deepseek-ai/cordis": "*",
    "@deepseek-ai/dsh-tools": "*",
    "@deepseek-ai/dsh-system-prompt": "*",
    "@deepseek-ai/dsh-working-directory": "*"
  },
  "devDependencies": {
    "@types/node": "^22.10.0",
    "typescript": "^5.6.0"
  }
}
